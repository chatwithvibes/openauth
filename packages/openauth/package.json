{
  "name": "@chatwithvibes/openauth",
  "version": "1.0.1",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test",
    "prepare": "bun run build"
  },
  "sideEffects": false,
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241205.0",
    "@tsconfig/node22": "22.0.0",
    "@types/node": "22.10.1",
    "arctic": "2.2.2",
    "hono": "4.6.9",
    "typescript": "5.6.3",
    "valibot": "1.0.0-beta.15"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./*": {
      "import": "./dist/esm/*.js",
      "types": "./dist/types/*.d.ts"
    },
    "./ui": {
      "import": "./dist/esm/ui/index.js",
      "types": "./dist/types/ui/index.d.ts"
    },
    "./provider/*": {
      "import": "./dist/esm/provider/*.js",
      "types": "./dist/types/provider/*.d.ts"
    },
    "./storage/*": {
      "import": "./dist/esm/storage/*.js",
      "types": "./dist/types/storage/*.d.ts"
    }
  },
  "peerDependencies": {
    "arctic": "^2.2.2",
    "hono": "^4.0.0"
  },
  "dependencies": {
    "@standard-schema/spec": "1.0.0-beta.3",
    "aws4fetch": "1.0.20",
    "jose": "5.9.6",
    "@nats-io/nats-core": "^3.0.0",
    "@nats-io/transport-node": "^3.0.0",
    "@nats-io/jetstream": "^3.0.0",
    "@nats-io/kv": "^3.0.0"
  },
  "files": [
    "src",
    "dist"
  ]
}
